{
  "name": "veloop-wallet-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node seed/seed.js",
    "seed:payout-options": "node seed/seedPayoutOptions.js",
    "seed:streak": "node seed/seedStreakConfig.js",
    "test": "node --test --test-isolation=none tests/wallet.integration.test.js",
    "db-up": "docker compose -f ../database/docker-compose.yml up -d",
    "db-down": "docker compose -f ../database/docker-compose.yml down"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.4",
    "razorpay": "^2.9.6"
  },
  "engines": {
    "node": ">=22"
  }
}
