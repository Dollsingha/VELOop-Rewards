PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/veloop_wallet?replicaSet=rs0
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# 32-byte hexadecimal key used to encrypt stored payout details.
PAYOUT_DETAILS_ENCRYPTION_KEY=replace_with_64_hexadecimal_characters

# Use Razorpay TEST keys first. Keep the secret only in the backend/Render environment.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
# Replace these example package values with the approved VES price/rate before enabling payments.
# amountPaise is in paise (₹100 = 10000). ves must be a positive whole number.
VES_PURCHASE_PACKAGES=[{"id":"ves-100","label":"Starter VES Pack","ves":1000,"amountPaise":10000}]

# Optional backend RazorpayX sandbox payouts. Use your own test account.
RAZORPAYX_TEST_ENABLED=false
RAZORPAYX_TEST_KEY_ID=
RAZORPAYX_TEST_KEY_SECRET=
RAZORPAYX_TEST_ACCOUNT_NUMBER=
RAZORPAYX_TEST_WEBHOOK_SECRET=
